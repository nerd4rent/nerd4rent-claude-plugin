{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./hooks/session-start.ts"
      },
      {
        "command": "node ./scripts/check-install.ts --runtime cursor"
      },
      {
        "command": "node ./hooks/require-issue.ts --runtime cursor --event reminder",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./hooks/require-issue.ts --runtime cursor --event gate",
        "matcher": "git (commit|push)",
        "timeout": 5
      }
    ]
  }
}
