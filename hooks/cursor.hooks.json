{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/session-start.sh"
      },
      {
        "command": "./hooks/check-install.sh cursor"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "./hooks/deny-vault-mcp.sh",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "./hooks/deny-vault-mcp.sh",
        "failClosed": true
      }
    ]
  }
}
