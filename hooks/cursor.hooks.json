{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./hooks/session-start.ts"
      },
      {
        "command": "node ./scripts/check-install.ts --runtime cursor"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node ./hooks/deny-vault-mcp.ts",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node ./hooks/deny-vault-mcp.ts",
        "failClosed": true
      }
    ]
  }
}
